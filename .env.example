# Copy to .env and adjust. Never commit .env.

# Database: "pglite://memory", "pglite://<directory>" (local, no install needed) or a postgres:// URL.
DATABASE_URL=pglite://.data/pglite

# Migrations use this direct connection when it is set beside a pooled DATABASE_URL.
# The Neon integration on Vercel sets both (ADR 0007).
# DATABASE_URL_UNPOOLED=
# On Vercel, only production builds migrate. Set to 1 when preview deployments have their own database.
# MIGRATE_PREVIEWS=1

# Where raw copies of downloaded data files are kept (TRD-01): "files" (in RAW_STORAGE_DIR) or
# "database" (the trend_raw_files table). The default is "database" on Vercel, "files" elsewhere (ADR 0007).
# RAW_STORAGE=files
RAW_STORAGE_DIR=.data/raw

# Identifies us to AITraining.jobs. Add a contact address once the product domain exists.
TRENDS_USER_AGENT=ai-training-platform-trends/0.1

# The app server collects the trend figures every 6 hours by itself (TRD-01, ADR 0006), except on
# Vercel, where the schedule in vercel.json calls /api/trends/collect instead (ADR 0007).
# "off" when a cron job runs `npm run trends:collect` instead, or on all but one server when several run;
# "on" to run it on Vercel anyway.
# TRENDS_SCHEDULE=off

# Secret for /api/trends/collect: callers send "Authorization: Bearer <CRON_SECRET>". At least 16
# characters; without it the address is switched off. Required on Vercel, where the schedule uses it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# Contact form (CON-04). Required in production: a random secret of at least 32 characters,
# mixed into the stored hash of each sender's network address. The server will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SECRET=

# Where the sender's address comes from. The hosting proxy appends the address it saw to this header;
# set the number of proxies in front of the app (1 for Vercel, a single nginx or a load balancer).
# CONTACT_ADDRESS_HEADER=x-forwarded-for
# CONTACT_TRUSTED_PROXY_HOPS=1
