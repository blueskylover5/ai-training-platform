# Copy to .env and adjust. Never commit .env.

# Database: "pglite://memory", "pglite://<directory>" (local, no install needed) or a postgres:// URL.
DATABASE_URL=pglite://.data/pglite

# Where raw copies of downloaded data files are kept (TRD-01).
RAW_STORAGE_DIR=.data/raw

# Identifies us to AITraining.jobs. Add a contact address once the product domain exists.
TRENDS_USER_AGENT=ai-training-platform-trends/0.1
